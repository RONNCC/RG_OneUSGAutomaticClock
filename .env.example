ONEUSG_USERNAME=your_gt_username
ONEUSG_PASSWORD=your_gt_password

# Duo OTP URI for automated 2FA (supports TOTP or HOTP).
# Leave blank if you want to approve Duo manually.
ONEUSG_DUO_OTP_URI=

# Optional: increase if manual Duo approval takes longer than 120 seconds.
# ONEUSG_DUO_TIMEOUT=120

# Optional: directory for screenshots/HTML when running with --debug.
# ONEUSG_DUMP_DIR=./dumps

# Optional HOTP fallback if you are not using ONEUSG_DUO_OTP_URI.
# ONEUSG_DUO_HOTP_SECRET=
# ONEUSG_DUO_HOTP_COUNTER_FILE=~/.duo_hotp_counter